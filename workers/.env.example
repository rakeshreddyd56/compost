# Compost Workers env — copy to .env and fill in.
# After filling, push to deployed worker: `ntn workers env push`

# Public Worker ID. Used by demo scripts when workers.json is not present.
COMPOST_WORKER_ID=019e31dc-050f-7a85-974a-21954fd261f5

# Notion integration token (NOT the OAuth flow — internal integration).
# Hosted Worker secrets reject user-managed NOTION_* keys, so use COMPOST_NOTION_TOKEN.
# Create at: https://www.notion.so/profile/integrations/internal
# Share the Compost Demo workspace pages AND the managed Worker databases
# (Compost Pile, Frozen Drafts, Cue Cards) with this integration.
COMPOST_NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — for Sleep-On-It rewrites + Cue calm rephrase + Weekly summary
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — for Gardener embedding dedup
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# User timezone for late-night gate (Sleep-On-It) and Sunday gate (Weekly)
USER_TIMEZONE=America/Los_Angeles

# Set after first Sleep-On-It webhook verification POST (Notion sends one verification_token; capture from logs)
# COMPOST_WEBHOOK_SECRET=verification_token_from_logs

# Demo overrides (delete after demo). When enabled, the worker logs a warning
# once per process so forced demo behavior is visible in logs.
# SLEEP_ON_IT_FORCE_FIRE=true
# WEEKLY_FORCE_FIRE=true

# Set after first deploy to find the data source IDs:
# Run: ntn datasources resolve <database-id>
COMPOST_PILE_DATA_SOURCE_ID=
FROZEN_DRAFTS_DATA_SOURCE_ID=
# WEEKLY_SNAPSHOTS_DATA_SOURCE_ID=

# Notion parent page for The Weekly digest pages
# Find page ID by opening the page and copying from the URL
COMPOST_PARENT_PAGE_ID=
